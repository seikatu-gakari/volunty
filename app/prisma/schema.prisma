// Volunty — Prisma スキーマ定義
// docs/design/personality-matching-redesign.md に準拠。
// テーブル命名規則: マスタ系 m_xxx / トランザクション系 t_xxx

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Enums
// ============================================

/// ユーザーロール
enum UserRole {
  participant // ボランティア参加者
  organization // 募集団体
  admin // 管理者

  @@map("user_role")
}

/// 募集案件ステータス
enum OpportunityStatus {
  draft // 下書き
  published // 公開中
  closed // 締切済み

  @@map("opportunity_status")
}

/// 参加形態
enum ParticipationMode {
  online // オンライン
  offline // オフライン（対面）
  hybrid // ハイブリッド

  @@map("participation_mode")
}

/// マッチング（応募）ステータス
enum MatchingStatus {
  queued // キュー待ち（レコメンド生成済み）
  applied // 応募済み
  accepted // 承認済み
  declined // 辞退・不採用
  completed // 完了
  cancelled // 参加キャンセル

  @@map("matching_status")
}

/// 団体審査ステータス
enum OrganizationReviewStatus {
  pending
  approved
  rejected

  @@map("organization_review_status")
}

/// 団体から参加者へのアプローチ回答ステータス
enum ApproachStatus {
  sent
  accepted
  declined

  @@map("approach_status")
}

/// 参加証明書ステータス
enum CertificateStatus {
  pending // 申請中
  issued // 承認・発行済み
  rejected // 却下

  @@map("certificate_status")
}

/// エンゲージメントイベント種別
enum EngagementEventType {
  view // 募集詳細の閲覧
  favorite // お気に入り登録

  @@map("engagement_event_type")
}

/// エンゲージメントの流入元
enum EngagementSource {
  recommendation // 推薦一覧から
  search // 検索・一覧から
  direct // 直接アクセス

  @@map("engagement_source")
}

/// 参加評価の評価者ロール
enum FeedbackRaterRole {
  participant // 参加者による団体・活動への評価
  organization // 団体による参加者への評価

  @@map("feedback_rater_role")
}

// ============================================
// マスタテーブル（m_ プレフィックス）
// ============================================

/// ユーザー — Supabase Auth と連携
/// id は auth.users.id と一致させる（トリガーで自動作成）
model User {
  id            String    @id @db.Uuid
  role          UserRole  @default(participant)
  email         String?   @db.VarChar(255)
  name          String?   @db.VarChar(100)
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  suspendedAt   DateTime? @map("suspended_at")
  suspendReason String?   @map("suspend_reason") @db.Text
  suspendedBy   String?   @map("suspended_by") @db.Uuid
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // リレーション
  participantProfile  ParticipantProfile?
  organizationProfile OrganizationProfile?
  diagnosisResults    DiagnosisResult[]
  matchingCandidates  MatchingCandidate[]
  certificates        Certificate[]
  recommendationLogs  RecommendationLog[]
  engagementEvents    EngagementEvent[]
  legalConsents       LegalConsent[]

  @@index([email])
  @@index([role])
  @@map("m_user")
}

/// 登録時に同意した公開文書の版を記録する履歴。
/// 同一ユーザー・同一版の再送は一意制約で冪等に扱う。
model LegalConsent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  termsVersion   String   @map("terms_version") @db.VarChar(50)
  privacyVersion String   @map("privacy_version") @db.VarChar(50)
  agreedAt       DateTime @map("agreed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, privacyVersion])
  @@index([userId, agreedAt])
  @@map("t_legal_consent")
}

/// アカウント削除の部分失敗を再処理するための一時台帳。
/// m_user への外部キーは張らず、cleanup 完了時に同一 transaction で削除する。
model AccountDeletionRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  authDeletedAt  DateTime? @map("auth_deleted_at")
  attemptCount   Int       @default(0) @map("attempt_count")
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("t_account_deletion_request")
}

/// 参加者プロフィール — ボランティア参加希望者の詳細情報
/// 診断結果は t_diagnosis_result に保存し、最新結果への参照のみ持つ
model ParticipantProfile {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String   @unique @map("user_id") @db.Uuid
  name                    String   @db.VarChar(100)
  birthday                DateTime @db.Date
  gender                  String?  @db.VarChar(20)
  bio                     String?  @db.Text
  lineId                  String?  @map("line_id") @db.VarChar(100)
  region                  String   @db.VarChar(100) // 居住都道府県（必須）
  interests               Json? // 興味分野 ["環境保全", "子ども支援"]
  latestDiagnosisResultId String?  @unique @map("latest_diagnosis_result_id") @db.Uuid
  availability            Json? // {"weekdays": ["土", "日"], "time": "午前"}
  preferredLocation       String?  @map("preferred_location") @db.VarChar(100)
  publicProfile           Boolean  @default(true) @map("public_profile")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // リレーション
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  latestDiagnosisResult DiagnosisResult? @relation("LatestDiagnosis", fields: [latestDiagnosisResultId], references: [id], onDelete: SetNull)
  approaches            Approach[]

  @@index([preferredLocation])
  @@map("m_participant_profile")
}

/// 団体プロフィール — ボランティア募集団体の情報
model OrganizationProfile {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String                   @unique @map("user_id") @db.Uuid
  organizationName    String                   @map("organization_name") @db.VarChar(255)
  representativeName  String?                  @map("representative_name") @db.VarChar(100)
  contactEmail        String?                  @map("contact_email") @db.VarChar(255)
  activityAreas       Json?                    @map("activity_areas") // ["渋谷区", "世田谷区"]
  description         String?                  @db.Text
  activityCategories  Json?                    @map("activity_categories") // ["環境保全", "子ども支援"]
  websiteUrl          String?                  @map("website_url")
  logoUrl             String?                  @map("logo_url")
  contactLineId       String?                  @map("contact_line_id") @db.VarChar(100)
  contactLineUrl      String?                  @map("contact_line_url")
  reviewStatus        OrganizationReviewStatus @default(pending) @map("review_status")
  reviewComment       String?                  @map("review_comment") @db.Text
  reviewedAt          DateTime?                @map("reviewed_at")
  reviewedBy          String?                  @map("reviewed_by") @db.Uuid
  verified            Boolean                  @default(false)
  profileCompleteness Int                      @default(0) @map("profile_completeness")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  // リレーション
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  approaches    Approach[]
  certificates  Certificate[]
  messageTemplates MessageTemplate[]

  @@index([reviewStatus])
  @@index([verified])
  @@index([organizationName])
  @@map("m_organization_profile")
}

/// メッセージテンプレート — 団体がアプローチ文を再利用するための定型文
model MessageTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization OrganizationProfile @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("m_message_template")
}

/// 募集案件 — 団体が投稿するボランティア募集情報
/// 旧 requirement_traits（求める性格特性の数値）は廃止し、
/// 活動スタイルタグ（加点のみ）とハード条件（資格・年齢）に分離した
model Opportunity {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String             @map("organization_id") @db.Uuid
  title                  String             @db.VarChar(255)
  description            String?            @db.Text
  activityStyleTags      Json?              @map("activity_style_tags") // 活動スタイルタグID配列（最大3・加点のみ）
  requiredQualifications Json?              @map("required_qualifications") // 必須資格（表示用。応募判断は団体が行う）
  minAge                 Int?               @map("min_age") // 法的・安全上必要な場合のみ設定
  maxAge                 Int?               @map("max_age") // 法的・安全上必要な場合のみ設定
  location               String?            @db.VarChar(255)
  startDate              DateTime?          @map("start_date") @db.Date
  endDate                DateTime?          @map("end_date") @db.Date
  schedule               String?            @db.Text
  capacity               Int?
  category               String?            @db.VarChar(50) // カテゴリ
  participationMode      ParticipationMode? @map("participation_mode") // 参加形態
  currentApplicants      Int                @default(0) @map("current_applicants")
  cost                   String?            @db.Text
  belongings             String?            @db.Text
  applicationDeadline    DateTime?          @map("application_deadline") @db.Date
  cancellationPolicy     String?            @map("cancellation_policy") @db.Text
  insuranceDetails       String?            @map("insurance_details") @db.Text
  contactMethod          String?            @map("contact_method") @db.Text
  status                 OpportunityStatus  @default(draft)
  publishedAt            DateTime?          @map("published_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  // リレーション
  organization       OrganizationProfile @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  matchingCandidates MatchingCandidate[]
  approaches         Approach[]
  certificates       Certificate[]
  recommendationLogs RecommendationLog[]
  engagementEvents   EngagementEvent[]

  @@index([status])
  @@index([publishedAt])
  @@index([organizationId])
  @@map("m_opportunity")
}

// ============================================
// トランザクションテーブル（t_ プレフィックス）
// ============================================

/// 診断結果 — BIG5 の連続スコアを主結果として保存する
/// 尺度・採点・標準化・参考タイプの各バージョンを必ず保存し、
/// 同じ回答と同じバージョンから常に同じ結果を再計算できるようにする
model DiagnosisResult {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  scaleCode               String   @map("scale_code") @db.VarChar(50) // 例: ipip-bfm-50-ja
  scaleVersion            String   @map("scale_version") @db.VarChar(20)
  scoringAlgorithmVersion String   @map("scoring_algorithm_version") @db.VarChar(20)
  normsVersion            String?  @map("norms_version") @db.VarChar(20) // 日本人標準化データがないため当面 null
  styleTypeVersion        String   @map("style_type_version") @db.VarChar(20)
  qualityRuleVersion      String   @map("quality_rule_version") @db.VarChar(20)
  rawScores               Json     @map("raw_scores") // {"extraversion": 34, ...} ドメイン合計（整数）
  scaledScores            Json     @map("scaled_scores") // {"extraversion": 60.0, ...} 表示用 0-100
  styleTypeId             String?  @map("style_type_id") @db.VarChar(50) // 参考タイプID（コード定数のキー）
  qualityFlags            Json     @map("quality_flags") // ["too_fast", ...] 空配列可
  totalDurationMs         Int?     @map("total_duration_ms")
  resumedCount            Int      @default(0) @map("resumed_count")
  answeredAt              DateTime @default(now()) @map("answered_at")
  createdAt               DateTime @default(now()) @map("created_at")

  // リレーション
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses          DiagnosisResponse[]
  latestForProfile   ParticipantProfile? @relation("LatestDiagnosis")
  recommendationLogs RecommendationLog[]

  @@index([userId])
  @@index([answeredAt])
  @@map("t_diagnosis_result")
}

/// 診断の生回答 — 常に保存する
/// 保存目的: 回答品質の検証と、日本語版尺度の信頼性・因子構造の自社検証
/// アカウント削除・診断結果削除で連鎖削除される
model DiagnosisResponse {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  diagnosisResultId String   @map("diagnosis_result_id") @db.Uuid
  itemCode          String   @map("item_code") @db.VarChar(50)
  value             Int // 1-5
  elapsedMs         Int?     @map("elapsed_ms")
  changedCount      Int?     @map("changed_count")
  createdAt         DateTime @default(now()) @map("created_at")

  // リレーション
  diagnosisResult DiagnosisResult @relation(fields: [diagnosisResultId], references: [id], onDelete: Cascade)

  @@unique([diagnosisResultId, itemCode])
  @@index([diagnosisResultId])
  @@map("t_diagnosis_response")
}

/// 推薦ログ — 推薦の生成・表示を記録し、マッチング精度を将来評価可能にする
model RecommendationLog {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  opportunityId       String   @map("opportunity_id") @db.Uuid
  rank                Int // 表示順位（1始まり）
  totalScore          Float    @map("total_score") // 0-1
  ruleContributions   Json     @map("rule_contributions") // ルール別寄与
  reasons             Json // 表示した推薦理由
  matchingRuleVersion String   @map("matching_rule_version") @db.VarChar(20)
  diagnosisResultId   String?  @map("diagnosis_result_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  // リレーション
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity        Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  diagnosisResult    DiagnosisResult?    @relation(fields: [diagnosisResultId], references: [id], onDelete: SetNull)
  matchingCandidates MatchingCandidate[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([opportunityId])
  @@map("t_recommendation_log")
}

/// エンゲージメントイベント — 閲覧・お気に入りを流入元とともに記録する
model EngagementEvent {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  opportunityId String              @map("opportunity_id") @db.Uuid
  event         EngagementEventType
  source        EngagementSource
  createdAt     DateTime            @default(now()) @map("created_at")

  // リレーション
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([opportunityId, event])
  @@map("t_engagement_event")
}

/// マッチング候補 — 参加者と募集案件の応募状態を管理
/// 旧 match_score / score_breakdown / method は廃止。
/// どの推薦から応募に至ったかは recommendation_log_id で追跡する
model MatchingCandidate {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantId       String         @map("participant_id") @db.Uuid
  opportunityId       String         @map("opportunity_id") @db.Uuid
  recommendationLogId String?        @map("recommendation_log_id") @db.Uuid
  status              MatchingStatus @default(queued)
  message             String?        @db.Text // 応募メッセージ
  appliedAt           DateTime?      @map("applied_at")
  statusChangedAt     DateTime       @default(now()) @map("status_changed_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  // リレーション
  participant       User               @relation(fields: [participantId], references: [id], onDelete: Cascade)
  opportunity       Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  recommendationLog RecommendationLog? @relation(fields: [recommendationLogId], references: [id], onDelete: SetNull)
  certificate       Certificate?
  feedbacks         ParticipationFeedback[]

  @@unique([participantId, opportunityId])
  @@index([status])
  @@index([participantId])
  @@index([opportunityId])
  @@map("t_matching_candidate")
}

/// 参加評価 — 参加完了後の相互評価（参加者→活動 / 団体→参加者）
model ParticipationFeedback {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  raterRole     FeedbackRaterRole @map("rater_role")
  rating        Int // 1-5
  comment       String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")

  // リレーション
  application MatchingCandidate @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, raterRole])
  @@index([applicationId])
  @@map("t_participation_feedback")
}

/// アプローチ — 団体から参加者へのアプローチ文と回答状態を管理
model Approach {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String         @map("organization_id") @db.Uuid
  participantProfileId String         @map("participant_profile_id") @db.Uuid
  opportunityId        String         @map("opportunity_id") @db.Uuid
  message              String         @db.Text
  status               ApproachStatus @default(sent)
  expiresAt            DateTime       @map("expires_at")
  respondedAt          DateTime?      @map("responded_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  // リレーション
  organization       OrganizationProfile @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participantProfile ParticipantProfile  @relation(fields: [participantProfileId], references: [id], onDelete: Cascade)
  opportunity        Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, participantProfileId, opportunityId])
  @@index([organizationId])
  @@index([participantProfileId])
  @@index([opportunityId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt(sort: Desc)])
  @@map("t_approach")
}

/// 参加証明書 — 活動完了済み応募に対する証明書申請・発行状態を管理
model Certificate {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId     String            @unique @map("application_id") @db.Uuid
  participantId     String            @map("participant_id") @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  opportunityId     String            @map("opportunity_id") @db.Uuid
  status            CertificateStatus @default(pending)
  certificateNumber String?           @unique @map("certificate_number") @db.VarChar(40)
  requestedAt       DateTime          @default(now()) @map("requested_at")
  approvedAt        DateTime?         @map("approved_at")
  issuedAt          DateTime?         @map("issued_at")
  rejectedAt        DateTime?         @map("rejected_at")
  rejectionReason   String?           @map("rejection_reason") @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  // リレーション
  application  MatchingCandidate   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  participant  User                @relation(fields: [participantId], references: [id], onDelete: Cascade)
  organization OrganizationProfile @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunity  Opportunity         @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([participantId])
  @@index([organizationId])
  @@index([opportunityId])
  @@index([requestedAt(sort: Desc)])
  @@index([issuedAt(sort: Desc)])
  @@map("t_certificate")
}
